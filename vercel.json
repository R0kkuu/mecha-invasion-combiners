{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/thumbs/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/images/:path*",
      "destination": "https://raw.githubusercontent.com/R0kkuu/mecha-invasion-combiners/main/images/:path*"
    },
    {
      "source": "/thumbs/:path*",
      "destination": "https://raw.githubusercontent.com/R0kkuu/mecha-invasion-combiners/main/thumbs/:path*"
    },
    {
      "source": "/data/:path*",
      "destination": "https://raw.githubusercontent.com/R0kkuu/mecha-invasion-combiners/main/data/:path*"
    },
    {
      "source": "/UPDATE.md",
      "destination": "https://raw.githubusercontent.com/R0kkuu/mecha-invasion-combiners/main/UPDATE.md"
    }
  ],
  "github": {
    "silent": true
  }
}
